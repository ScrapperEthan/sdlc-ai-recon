# recon working data — regenerated, never commit
poms/
recon_out/
names.txt
repos/

# python
__pycache__/
*.pyc

# local webapp session history
webapp_data/

# eval output
evals/last_run.json

# generated index freshness metadata
index/last_indexed.json
index/*.json
index/reports/

# data exports (bank no-egress; box-local only, never commit)
index/*.snapshot.csv
index/usecase-snapshots/
# internal domain documents dropped into index/ (e.g. the MDC Common Knowledge markdown).
# This repo is PUBLIC — index/ is the box-local side and nothing in it should ever be committed.
index/*.md
index/*.csv
index/*.xlsx

# per-bundle CodeGraph staging trees + indexes (copied sources, regenerated by build_codegraph.py)
index/codegraph/

# human-reviewed generated scratch outputs
scratch/

# eval placeholder map: the shipped config/eval_repos.json is an EMPTY public template;
# the box keeps its real repo/use-case ids here and they must never be committed.
/config/eval_repos.local.json

# the intranet's read-only DB skill. It holds their token provider and endpoint details, is
# git-excluded on their box, and must never be committed here either. We import its runner from a
# path in SDLC_DB_SKILL; nothing about it belongs in this repo.
/.github/skills/

# the box's REAL db_queries config (real schemas, tables, columns, SQL), pointed at by
# SDLC_DB_QUERIES. The committed config/db_queries.json is an all-"?" template: the intranet cannot
# push, so editing the tracked file on the box guarantees a pull conflict. This is the same
# arrangement as SDLC_MCP_TOOLS.
/config/db_queries.local.json

# the box's business-enum answers. The committed config/business_enums.json carries what the owner
# has confirmed so far; the real export also contains send_mode codes 0/4/5 that nobody has defined
# yet. When those answers land, the intranet must be able to write them on the box the same day —
# and they cannot push, so editing the tracked file would refuse their next pull. Same arrangement
# as db_queries.local.json.
/config/business_enums.local.json
